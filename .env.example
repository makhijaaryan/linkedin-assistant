# Copy to .env and fill in. Never commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-min-8-chars

OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=            # console.groq.com/keys (starts with gsk_)
GEMINI_API_KEY=          # aistudio.google.com, personal Google account (proprietary baseline)
OPENROUTER_API_KEY=      # optional fallback, not required

# Lightcast Open Skills (R3 normalization) — apply at lightcast.io/taxonomies/skills-taxonomy/access
LIGHTCAST_CLIENT_ID=
LIGHTCAST_CLIENT_SECRET=
LIGHTCAST_SCOPE=lightcast_open_free

# Adzuna job feed (freshness checks) — developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Kaggle: either put kaggle.json in ~/.kaggle/ or set these
KAGGLE_USERNAME=
KAGGLE_KEY=
