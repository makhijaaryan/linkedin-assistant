# Copy to .env and fill in. Never commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-min-8-chars

OLLAMA_BASE_URL=http://localhost:11434/v1

# Hosted open-weight models: ASU Voyager (https://openai.rc.asu.edu/v1), free for ASU accounts (D31)
ASU_API_KEY=
# Proprietary baseline: Azure OpenAI gpt-5-mini; set the endpoint in config.yaml -> providers.azure (D31)
AZURE_OPENAI_API_KEY=

# Live jobs in the app (optional) — developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Kaggle: either put kaggle.json in ~/.kaggle/ or set these
KAGGLE_USERNAME=
KAGGLE_KEY=

# Superseded providers, kept for the earlier partial runs (config.yaml marks them unused)
GROQ_API_KEY=            # console.groq.com/keys
GEMINI_API_KEY=          # aistudio.google.com
OPENROUTER_API_KEY=
# Lightcast was dropped for O*NET (D14); scripts/fetch_lightcast.py is kept in case access comes through
LIGHTCAST_CLIENT_ID=
LIGHTCAST_CLIENT_SECRET=
LIGHTCAST_SCOPE=lightcast_open_free
